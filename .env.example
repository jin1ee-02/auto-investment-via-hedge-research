# Keep this file as a template. Copy to .env for Python; never commit secrets.
# For a local Vinext worker also copy RESEARCH_SERVICE_* into .dev.vars.
SEC_USER_AGENT=Your Name your-real-contact-email@example.com

# Choose one of anthropic / openai / google / deepseek / openrouter.
# Model IDs must be valid for YOUR account; no model is silently selected.
RESEARCH_PROVIDER=
RESEARCH_DEEP_MODEL=
RESEARCH_QUICK_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Only needed for Ollama / custom OpenAI-compatible endpoints.
RESEARCH_BACKEND_URL=
OPENAI_COMPATIBLE_API_KEY=

RESEARCH_SERVICE_URL=http://127.0.0.1:8788
RESEARCH_SERVICE_TOKEN=
# Optional absolute Node 22.13+ executable path, otherwise use PATH.
NODE_BINARY=

# Server-side only. WTS > Settings > Open API; register the executor's allowed IP.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=
# Enable after reviewing strategy.json and a Toss dry run.
TOSS_ENABLE_LIVE=false
